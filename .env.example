# Database
POSTGRES_USER=brandengine
POSTGRES_PASSWORD=brandengine123
POSTGRES_DB=brandengine
DATABASE_URL=postgresql://brandengine:brandengine123@localhost:5432/brandengine

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO (S3 compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=brand-engine
MINIO_SECURE=false

# Storage fallback (local filesystem if MinIO unavailable)
LOCAL_STORAGE_PATH=/data

# Security
SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Optional: OpenAI for advanced analysis
# Leave empty to use mock provider
OPENAI_API_KEY=

# Logging
LOG_LEVEL=INFO

# Upload limits
MAX_UPLOAD_SIZE_MB=100
